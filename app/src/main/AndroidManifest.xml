<?xml version="1.0" encoding="utf-8"?>
<!--
  CRITICAL: every class name below is a FULLY-QUALIFIED class name (FQCN).
  Do NOT shorten them to ".HomeActivity" / ".MontageApp" — relative names
  resolve against the manifest package and produce ClassNotFoundException
  at launch (the classic "app dies instantly on open" crash).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <application
        android:name="com.videomontage.app.MontageApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Montage"
        android:hardwareAccelerated="true">

        <activity
            android:name="com.videomontage.ui.home.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.videomontage.ui.editor.EditorActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

    </application>

</manifest>
