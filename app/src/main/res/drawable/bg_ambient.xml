<?xml version="1.0" encoding="utf-8"?>
<!-- The shared ambient backdrop. Slow diagonal gradient: aurora at the
     edges, ink in the middle, so content floats over quiet depth. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="@color/aurora_c"
        android:centerColor="@color/ink"
        android:endColor="@color/aurora_b" />
</shape>
