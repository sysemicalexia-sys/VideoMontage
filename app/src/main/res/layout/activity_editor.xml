<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <com.videomontage.widgets.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="280dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_top_bar"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="8dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:src="@drawable/ic_back"
            android:background="@drawable/bg_icon_button"
            android:tint="@color/text_primary"
            android:contentDescription="@string/cancel" />

        <TextView
            android:id="@+id/projectName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/exportButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/ic_export"
            android:background="@drawable/bg_icon_button"
            android:tint="@color/text_primary"
            android:contentDescription="@string/export_started" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="12dp">

        <LinearLayout
            android:id="@+id/transport"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/undo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_undo"
                android:background="@drawable/bg_icon_button"
                android:tint="@color/text_primary"
                android:contentDescription="Undo" />

            <ImageButton
                android:id="@+id/redo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_redo"
                android:background="@drawable/bg_icon_button"
                android:tint="@color/text_primary"
                android:contentDescription="Redo" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/timecode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="monospace" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/addClip"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_add"
                android:background="@drawable/bg_icon_button"
                android:tint="@color/text_primary"
                android:contentDescription="@string/create_project" />

            <ImageButton
                android:id="@+id/split"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_split"
                android:background="@drawable/bg_icon_button"
                android:tint="@color/text_primary"
                android:contentDescription="Split" />

            <ImageButton
                android:id="@+id/playPause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_play"
                android:background="@drawable/bg_play_button"
                android:tint="@color/bg_app"
                android:contentDescription="Play" />
        </LinearLayout>

        <TextView
            android:id="@+id/durationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingEnd="24dp"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <com.videomontage.widgets.TimelineView
            android:id="@+id/timeline"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</FrameLayout>
