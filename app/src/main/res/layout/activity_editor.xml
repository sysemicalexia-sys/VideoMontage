<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <!-- Preview dominates the interface. -->
    <com.videomontage.widgets.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="236dp" />

    <!-- Top chrome: back + project name + export. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:src="@drawable/ic_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel" />

        <TextView
            android:id="@+id/projectName"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/exportButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:src="@drawable/ic_export"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/export_started" />
    </LinearLayout>

    <!-- Bottom stack: transport floats over the timeline. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="236dp"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/transport"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/bg_transport">

            <ImageButton
                android:id="@+id/undo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_undo"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_name" />

            <ImageButton
                android:id="@+id/redo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_redo"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_name" />

            <ImageButton
                android:id="@+id/addClip"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_add"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/create_project" />

            <ImageButton
                android:id="@+id/split"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_split"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/timecode"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <ImageButton
                android:id="@+id/playPause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_play"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_name" />
        </LinearLayout>

        <TextView
            android:id="@+id/durationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <com.videomontage.widgets.TimelineView
            android:id="@+id/timeline"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</FrameLayout>
